# ============================================================
# Template de variáveis de ambiente — copie para .env e preencha
# O arquivo .env está no .gitignore e NUNCA deve ser commitado.
# ============================================================

# --- Supabase Database (Development) ---
# Conexão direta ao PostgreSQL (porta 5432, não o pooler 6543)
# Encontre a senha em: Supabase Dashboard > Project Settings > Database > Password
SUPABASE_DB_URL=jdbc:postgresql://db.avugtvhjgtlcilumrvmr.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres
SUPABASE_DB_PASSWORD=your_supabase_database_password_here

# --- Supabase API (usado pelo frontend / integrações) ---
SUPABASE_URL=https://avugtvhjgtlcilumrvmr.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# --- Produção (Railway / Render / Fly.io) ---
DB_URL=jdbc:postgresql://db.<project-id>.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=your_production_database_password_here

# --- Frontend ---
FRONTEND_URL=http://localhost:5173
